#!/usr/bin/env bash
# Zombies cannot receive signals: they have already exited. This script first
# asks their parents to reap them, then invokes wait4 in unresponsive parents.
# It can optionally terminate parents when direct reaping is unavailable.

set -uo pipefail

terminate_parents=false
force=false
dry_run=false
direct_reap=true
wait_seconds=2

usage() {
  cat <<'EOF'
Usage: kill-zombies [OPTIONS]

Ask parents of zombie processes to reap their children.

Options:
  -n, --dry-run            Show zombies and planned actions only
      --no-direct-reap     Do not invoke wait4 in parents using ptrace
  -t, --terminate-parents  Send TERM if direct reaping is disabled or fails
  -f, --force              After TERM, send KILL to unresponsive parents
  -w, --wait SECONDS       Wait between actions (default: 2)
  -h, --help               Show this help

Direct reaping currently requires Linux x86_64, Python 3, and permission to
ptrace the parent. PID 1 and ancestors of this script are never terminated.
EOF
}

while (($#)); do
  case "$1" in
    -n|--dry-run)
      dry_run=true
      ;;
    --no-direct-reap)
      direct_reap=false
      ;;
    -t|--terminate-parents)
      terminate_parents=true
      ;;
    -f|--force)
      force=true
      terminate_parents=true
      ;;
    -w|--wait)
      if (($# < 2)); then
        echo "Error: --wait requires a value" >&2
        exit 2
      fi
      wait_seconds=$2
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ ! $wait_seconds =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Error: wait time must be a non-negative number" >&2
  exit 2
fi

if ! command -v ps >/dev/null 2>&1; then
  echo "Error: this script requires the ps command" >&2
  exit 2
fi

# Output format: PID PPID STATE COMMAND. A command name contains no whitespace
# in the ps implementation normally used by Linux containers.
collect_zombies() {
  LC_ALL=C ps -eo pid=,ppid=,stat=,comm= 2>/dev/null |
    awk '$3 ~ /^Z/ { print $1, $2, $3, $4 }'
}

show_zombies() {
  local row pid ppid state command
  printf '%-8s %-8s %-8s %s\n' 'PID' 'PPID' 'STATE' 'COMMAND'
  for row in "$@"; do
    read -r pid ppid state command <<<"$row"
    printf '%-8s %-8s %-8s %s\n' "$pid" "$ppid" "$state" "$command"
  done
}

parents_from_snapshot() {
  local row pid ppid state command
  declare -A seen=()
  for row in "$@"; do
    read -r pid ppid state command <<<"$row"
    if [[ $ppid =~ ^[1-9][0-9]*$ && ! ${seen[$ppid]+_} ]]; then
      seen[$ppid]=1
      printf '%s\n' "$ppid"
    fi
  done
}

zombie_pids_for_parent() {
  local target=$1 row pid ppid state command
  shift
  for row in "$@"; do
    read -r pid ppid state command <<<"$row"
    [[ $ppid == "$target" ]] && printf '%s\n' "$pid"
  done
}

# A process can only wait for its own children. When a parent does not handle
# SIGCHLD (a common problem for PID 1 in containers), briefly trace one of its
# threads and execute wait4(child, NULL, WNOHANG, NULL) there. The original
# registers are restored before the parent resumes. Specific PIDs are used so
# exit statuses for unrelated children are not consumed.
reap_through_parent() {
  local parent=$1
  shift

  if ! command -v python3 >/dev/null 2>&1; then
    echo "Direct reaping requires python3." >&2
    return 1
  fi

  python3 - "$parent" "$@" <<'PY'
import ctypes
import errno
import os
import platform
import signal
import sys

PTRACE_SINGLESTEP = 9
PTRACE_GETREGS = 12
PTRACE_SETREGS = 13
PTRACE_DETACH = 17
PTRACE_SEIZE = 0x4206
PTRACE_INTERRUPT = 0x4207
SYS_WAIT4 = 61

parent = int(sys.argv[1])
candidates = [int(value) for value in sys.argv[2:]]

if platform.system() != "Linux" or platform.machine().lower() not in {
    "x86_64",
    "amd64",
}:
    raise SystemExit("direct reaping is currently supported only on Linux x86_64")

try:
    with open(f"/proc/{parent}/exe", "rb") as executable:
        elf_header = executable.read(20)
except OSError as error:
    raise SystemExit(f"cannot inspect parent {parent}: {error}") from error
if (
    elf_header[:5] != b"\x7fELF\x02"
    or elf_header[5] != 1
    or int.from_bytes(elf_header[18:20], "little") != 62
):
    raise SystemExit(f"parent {parent} is not a 64-bit x86 process")


class UserRegs(ctypes.Structure):
    _fields_ = [
        (name, ctypes.c_ulonglong)
        for name in (
            "r15", "r14", "r13", "r12", "rbp", "rbx", "r11", "r10",
            "r9", "r8", "rax", "rcx", "rdx", "rsi", "rdi", "orig_rax",
            "rip", "cs", "eflags", "rsp", "ss", "fs_base", "gs_base",
            "ds", "es", "fs", "gs",
        )
    ]


libc = ctypes.CDLL(None, use_errno=True)
libc.ptrace.restype = ctypes.c_long
libc.ptrace.argtypes = (
    ctypes.c_uint,
    ctypes.c_int,
    ctypes.c_void_p,
    ctypes.c_void_p,
)


def ptrace(request, address=0, data=0):
    data_pointer = (
        ctypes.cast(data, ctypes.c_void_p)
        if not isinstance(data, int)
        else ctypes.c_void_p(data)
    )
    ctypes.set_errno(0)
    result = libc.ptrace(
        request, parent, ctypes.c_void_p(address), data_pointer
    )
    error = ctypes.get_errno()
    if result == -1 and error:
        raise OSError(error, os.strerror(error))
    return result


def zombie_still_belongs_to_parent(pid):
    try:
        with open(f"/proc/{pid}/stat", encoding="ascii") as stat_file:
            stat = stat_file.read()
        # comm is parenthesized and may itself contain spaces or parentheses.
        fields = stat[stat.rfind(")") + 2 :].split()
        return fields[0] == "Z" and int(fields[1]) == parent
    except (FileNotFoundError, IndexError, OSError, ValueError):
        return False


def copy_regs(source):
    target = UserRegs()
    ctypes.memmove(ctypes.byref(target), ctypes.byref(source), ctypes.sizeof(target))
    return target


def find_syscall_instruction():
    executable_ranges = []
    with open(f"/proc/{parent}/maps", encoding="ascii") as maps_file:
        for line in maps_file:
            fields = line.split()
            if len(fields) < 2 or "x" not in fields[1]:
                continue
            start, end = (int(value, 16) for value in fields[0].split("-"))
            name = fields[-1] if len(fields) >= 6 else ""
            executable_ranges.append((name != "[vdso]", start, end))

    # The vDSO is small and normally contains several syscall instructions.
    # Other executable mappings are a conservative fallback.
    executable_ranges.sort()
    with open(f"/proc/{parent}/mem", "rb", buffering=0) as memory:
        for _, start, end in executable_ranges:
            offset = start
            while offset < end:
                size = min(1024 * 1024, end - offset)
                memory.seek(offset)
                block = memory.read(size)
                index = block.find(b"\x0f\x05")
                if index >= 0:
                    return offset + index
                if len(block) != size:
                    break
                offset += max(1, size - 1)
    raise RuntimeError("could not find a syscall instruction in the parent")


def interrupt(signum, frame):
    del frame
    raise RuntimeError(f"interrupted by signal {signum}")


for handled_signal in (signal.SIGALRM, signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(handled_signal, interrupt)
signal.setitimer(signal.ITIMER_REAL, min(120, 10 + len(candidates) / 100))

children = [pid for pid in candidates if zombie_still_belongs_to_parent(pid)]
if not children:
    print(0)
    raise SystemExit(0)

seized = False
saved_regs = None
detach_signal = 0
reaped = 0

try:
    ptrace(PTRACE_SEIZE)
    seized = True
    ptrace(PTRACE_INTERRUPT)
    waited_pid, status = os.waitpid(parent, 0)
    if waited_pid != parent or not os.WIFSTOPPED(status):
        raise RuntimeError("parent did not enter a ptrace stop")

    saved_regs = UserRegs()
    ptrace(PTRACE_GETREGS, data=ctypes.byref(saved_regs))
    syscall_instruction = find_syscall_instruction()

    for child in children:
        if not zombie_still_belongs_to_parent(child):
            continue

        regs = copy_regs(saved_regs)
        regs.rip = syscall_instruction
        regs.rax = SYS_WAIT4
        regs.orig_rax = ctypes.c_ulonglong(-1).value
        regs.rdi = child
        regs.rsi = 0
        regs.rdx = os.WNOHANG
        regs.r10 = 0
        ptrace(PTRACE_SETREGS, data=ctypes.byref(regs))
        ptrace(PTRACE_SINGLESTEP)

        waited_pid, status = os.waitpid(parent, 0)
        if waited_pid != parent or not os.WIFSTOPPED(status):
            seized = False
            raise RuntimeError("parent exited while direct reaping was in progress")
        if os.WSTOPSIG(status) != signal.SIGTRAP:
            stop_signal = os.WSTOPSIG(status)
            # SIGSYS was caused by the injected syscall being rejected; do not
            # redeliver it and accidentally terminate the parent.
            detach_signal = 0 if stop_signal == signal.SIGSYS else stop_signal
            raise RuntimeError(
                f"parent stopped for signal {stop_signal} during direct reaping"
            )

        result_regs = UserRegs()
        ptrace(PTRACE_GETREGS, data=ctypes.byref(result_regs))
        result = ctypes.c_longlong(result_regs.rax).value
        if result == child:
            reaped += 1
        elif result == -errno.ECHILD and not zombie_still_belongs_to_parent(child):
            # A different parent thread won the race and reaped it.
            continue
        elif result < 0:
            raise OSError(-result, os.strerror(-result))
        elif result == 0:
            raise RuntimeError(f"wait4 unexpectedly reported that zombie {child} is running")
finally:
    signal.setitimer(signal.ITIMER_REAL, 0)
    if seized:
        try:
            if saved_regs is not None:
                ptrace(PTRACE_SETREGS, data=ctypes.byref(saved_regs))
        finally:
            try:
                ptrace(PTRACE_DETACH, data=detach_signal)
            except ProcessLookupError:
                pass

print(reaped)
PY
}

process_name() {
  LC_ALL=C ps -o comm= -p "$1" 2>/dev/null | awk '{$1=$1; print}'
}

# Protect the container's PID 1 and the shell/session that launched this script.
declare -A protected=([1]=1 [$$]=1)
ancestor=$PPID
while [[ $ancestor =~ ^[1-9][0-9]*$ ]]; do
  protected[$ancestor]=1
  ((ancestor == 1)) && break
  next_ancestor=$(LC_ALL=C ps -o ppid= -p "$ancestor" 2>/dev/null | awk '{$1=$1; print}')
  [[ $next_ancestor =~ ^[1-9][0-9]*$ && $next_ancestor != "$ancestor" ]] || break
  ancestor=$next_ancestor
done

mapfile -t zombies < <(collect_zombies)
if ((${#zombies[@]} == 0)); then
  echo "No zombie processes found."
  exit 0
fi

echo "Found ${#zombies[@]} zombie process(es):"
show_zombies "${zombies[@]}"
mapfile -t parents < <(parents_from_snapshot "${zombies[@]}")

if $dry_run; then
  echo
  for parent in "${parents[@]}"; do
    name=$(process_name "$parent")
    echo "Would send SIGCHLD to parent $parent${name:+ ($name)}."
    $direct_reap && echo "Would directly reap any remaining zombies through parent $parent${name:+ ($name)}."
    if $terminate_parents; then
      if [[ ${protected[$parent]+_} ]]; then
        echo "Would not terminate protected parent $parent${name:+ ($name)}."
      else
        echo "Would send TERM to parent $parent${name:+ ($name)} if zombies remained."
        $force && echo "Would then send KILL if parent $parent remained unresponsive."
      fi
    fi
  done
  exit 0
fi

echo
for parent in "${parents[@]}"; do
  name=$(process_name "$parent")
  if kill -s CHLD "$parent" 2>/dev/null; then
    echo "Sent SIGCHLD to parent $parent${name:+ ($name)}."
  else
    echo "Could not signal parent $parent${name:+ ($name)}; it exited or permission was denied." >&2
  fi
done

sleep "$wait_seconds"
mapfile -t zombies < <(collect_zombies)
if ((${#zombies[@]} == 0)); then
  echo "All zombies were reaped."
  exit 0
fi

if $direct_reap; then
  mapfile -t parents < <(parents_from_snapshot "${zombies[@]}")
  echo
  for parent in "${parents[@]}"; do
    name=$(process_name "$parent")
    mapfile -t child_pids < <(zombie_pids_for_parent "$parent" "${zombies[@]}")
    if reaped=$(reap_through_parent "$parent" "${child_pids[@]}"); then
      if [[ $reaped =~ ^[0-9]+$ ]] && ((reaped > 0)); then
        echo "Reaped $reaped zombie(s) through parent $parent${name:+ ($name)}."
      fi
    else
      echo "Could not directly reap zombies through parent $parent${name:+ ($name)}." >&2
    fi
  done

  mapfile -t zombies < <(collect_zombies)
  if ((${#zombies[@]} == 0)); then
    echo "All zombies were reaped."
    exit 0
  fi
fi

if ! $terminate_parents; then
  echo "${#zombies[@]} zombie process(es) remain. Direct reaping may require the parent's user or ptrace permission." >&2
  echo "Re-run with --terminate-parents only if stopping their parents is safe." >&2
  exit 1
fi

mapfile -t parents < <(parents_from_snapshot "${zombies[@]}")
echo
for parent in "${parents[@]}"; do
  name=$(process_name "$parent")
  if [[ ${protected[$parent]+_} ]]; then
    echo "Skipping protected parent $parent${name:+ ($name)}." >&2
  elif kill -s TERM "$parent" 2>/dev/null; then
    echo "Sent TERM to parent $parent${name:+ ($name)}."
  else
    echo "Could not terminate parent $parent${name:+ ($name)}; it exited or permission was denied." >&2
  fi
done

sleep "$wait_seconds"
mapfile -t zombies < <(collect_zombies)
if ((${#zombies[@]} == 0)); then
  echo "All zombies were reaped."
  exit 0
fi

if $force; then
  mapfile -t parents < <(parents_from_snapshot "${zombies[@]}")
  echo
  for parent in "${parents[@]}"; do
    name=$(process_name "$parent")
    if [[ ${protected[$parent]+_} ]]; then
      echo "Skipping protected parent $parent${name:+ ($name)}." >&2
    elif kill -s KILL "$parent" 2>/dev/null; then
      echo "Sent KILL to parent $parent${name:+ ($name)}."
    else
      echo "Could not kill parent $parent${name:+ ($name)}; it exited or permission was denied." >&2
    fi
  done
  sleep "$wait_seconds"
  mapfile -t zombies < <(collect_zombies)
fi

if ((${#zombies[@]})); then
  echo "${#zombies[@]} zombie process(es) remain:" >&2
  show_zombies "${zombies[@]}" >&2
  echo "If their parent is PID 1, restart the container and use an init such as tini or Docker's --init option." >&2
  exit 1
fi

echo "All zombies were reaped."
